{% macro checkboxListField(name, selected_values, table_values, label, options) %}
    {% set options = {
        'full_width': false,
        'full_width_adapt_column': true,
        'label_class': 'col-xxl-5',
        'input_class': 'col-xxl-7',
        'add_field_class': '',
        'field_class': 'col-12 col-sm-6',
        'center': false,
        'mb': 'mb-3',
        'required': false,
        'disabled': false,
        'readonly': false,
        'helper': '',
        'rand': random()
    }|merge(options|default({})) %}

    {% set field %}
        <div class="form-check-list">
            {% for item_id, item_data in table_values %}
                {% set is_selected = false %}
                {% for selected_data, selected_id in selected_values|default([]) %}
                    {% if selected_id == item_id %}
                        {% set is_selected = true %}
                    {% endif %}
                {% endfor %}
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="{{ name }}[]"
                           data-group="{{ name }}"
                           value="{{ item_id }}"
                           id="{{ name }}_{{ item_id }}_{{ options.rand }}"
                           {% if is_selected %}checked{% endif %}
                            {% if options.disabled %}disabled{% endif %}
                            {% if options.readonly %}readonly{% endif %}>
                    <label class="form-check-label" for="{{ name }}_{{ item_id }}_{{ options.rand }}">
                        {{ item_data.name }}
                    </label>
                </div>
            {% endfor %}
        </div>
    {% endset %}

    {{ _self.field(name, field, label, options) }}
{% endmacro %}

{% macro escapePlainText(content) %}
    {{ content|replace({'\n': '<br/>',"\\'": "'", "\\\"": "\""})|raw }}
{% endmacro %}


{% macro badges(name, items, options = {}) %}
    {% set options = {
        'id': name|safe_dom_id,
        'label': name|capitalize,
        'class': 'col-form-label col-xxl-5 text-xxl-end',
        'badge_class': 'badge bg-secondary me-1',
        'helper': null,
    }|merge(options) %}

    <div class="form-field row align-items-center col-12 col-sm-6 mb-2">
        <label for="{{ options.id }}" class="{{ options.class }}">
            {{ options.label }}
            {% if options.helper %}
                <span class="form-help"
                      data-bs-toggle="popover"
                      data-bs-placement="top"
                      data-bs-html="true"
                      data-bs-content="{{ options.helper|escape|nl2br }}">
                    ?
                </span>
            {% endif %}
        </label>
        <div id="{{ options.id }}" class="col-xxl-7  field-container">
            {% for it in items %}
                <span class="{{ options.badge_class }}"
                      data-bs-toggle="tooltip"
                      data-bs-placement="top"
                      title="{{ it.description is defined ? it.description : it.name }}">
                    {{ it.name }}
                </span>
            {% else %}
                <span class="text-muted">{{ __('(none)') }}</span>
            {% endfor %}
        </div>
    </div>

    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
{% endmacro %}

